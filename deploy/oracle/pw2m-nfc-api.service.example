[Unit]
Description=PW2M NFC API
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/pw2m-nfc
ExecStart=/usr/bin/java -jar /opt/pw2m-nfc/pw2m-nfc-api.jar
Restart=always
RestartSec=5

Environment=SPRING_PROFILES_ACTIVE=prod
Environment=DB_URL=jdbc:mysql://MYSQL_PRIVADO:3306/pw2m_nfc?useSSL=true&serverTimezone=UTC
Environment=DB_USERNAME=pw2m_app
Environment=DB_PASSWORD=ALTERE
Environment=JWT_SECRET_BASE64=ALTERE
Environment=CORS_ALLOWED_ORIGINS=https://nfc.seudominio.com.br

[Install]
WantedBy=multi-user.target
